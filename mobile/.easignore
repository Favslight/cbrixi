# Dependencies are installed by EAS from package-lock.json.
node_modules/

# Local Expo state and generated build output.
.expo/
dist/
build/
web-build/

# Native build artifacts created locally by prebuild or native tooling.
android/.gradle/
android/app/build/
android/build/
ios/build/
ios/Pods/

# Environment files and local machine state.
.env
.env.*
!.env.example
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test, coverage, and cache output.
coverage/
.nyc_output/
.jest/
.turbo/
.cache/
.parcel-cache/

# Editor, OS, and repo metadata that is not needed for cloud builds.
.git/
.github/
.vscode/
.idea/
.DS_Store
Thumbs.db
